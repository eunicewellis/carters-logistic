# Carters Logistics — environment variables (copy to .env.local to override)

# Admin login credentials (username/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign admin login sessions (change this in production)
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Production (Vercel) ---
# Database (Vercel Postgres / Neon) — stores shipments, settings, and the admin password
POSTGRES_URL=

# Vercel Blob — stores uploaded product images (either token OR store id works)
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Transactional email (Resend) — sends the tracking number to the recipient + sender automatically.
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your domain (carterslogistic.com) at https://resend.com/domains and add the DNS records
# 3. Add support@carterslogistic.com as a sender on that domain
RESEND_API_KEY=
EMAIL_FROM=Carters Logistics <support@carterslogistic.com>
NEXT_PUBLIC_SITE_URL=https://carterslogistic.com
