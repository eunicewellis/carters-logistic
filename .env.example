# Carters Logistics — environment variables (copy to .env.local to override)

# Admin login credentials (username/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign admin login sessions (change this in production)
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Production (Vercel) ---
# Database (Vercel Postgres / Neon) — stores shipments, settings, and the admin password
POSTGRES_URL=

# Vercel Blob — stores uploaded product images
BLOB_READ_WRITE_TOKEN=

# Transactional email (Resend) — sends the tracking number to clients automatically
RESEND_API_KEY=
EMAIL_FROM=Carters Logistics <onboarding@resend.dev>
NEXT_PUBLIC_SITE_URL=https://carterslogistic.com
